{
  "name": "deviceview-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source responsive device testing studio with Direct Iframe and Remote Browser (Playwright/CDP) interactive preview engines.",
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "packages/device-registry",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node apps/server/dist/index.js",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "node scripts/build.mjs",
    "start": "NODE_ENV=production node apps/server/dist/index.js",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test-unit.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "companion": "node scripts/local-companion.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.1",
    "lucide-react": "^0.400.0",
    "playwright": "^1.45.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^1.6.0",
    "ws": "^8.17.1",
    "zustand": "^4.5.2"
  }
}
