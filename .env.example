# ============================================================================
# DeviceView Studio — Environment Configuration (.env.example)
# Copy this file to .env and adjust values as needed.
# ============================================================================

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*

# Execution Mode: "local" or "cloud"
# - "local": Allows previewing localhost (127.0.0.1, localhost:3000, 5173, 8080, etc.) directly from the machine.
# - "cloud": Blocks direct server-side access to localhost, private RFC1918 IPs, link-local, and cloud metadata endpoints (SSRF protection). Localhost testing in cloud mode requires the Local Companion Tunnel.
DEPLOYMENT_MODE=local

# Custom allowed private IPs or CIDR ranges (comma-separated, only used when explicitly configured by admin)
ALLOWED_HOSTS=

# Browser Preview Engine Configuration
# Supported drivers: "auto" (prefers Playwright if installed, falls back to direct Chromium CDP), "playwright", "cdp"
BROWSER_DRIVER=auto
CHROMIUM_PATH=/usr/bin/chromium
MAX_CONCURRENT_SESSIONS=6
SESSION_IDLE_TIMEOUT_MS=300000
SESSION_MAX_LIFETIME_MS=1800000
NAVIGATION_TIMEOUT_MS=20000
SCREENSHOT_FPS=4

# Local Companion Tunnel Security
# Shared secret or token required when connecting local-companion agent to a cloud instance
COMPANION_AUTH_SECRET=change-me-in-production-companion-secret
